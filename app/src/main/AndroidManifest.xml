<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Report received SMS to the server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The whole point of this app: receive SMS. Requested at runtime from the status screen. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Optional: read the SIM operator names for the pairing request. Slot numbers work without it. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Optional (Android 13+): tell the user when the token was revoked and the phone must be paired again. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Sending (docs/协议.md §6.2, §7): only requested when the user switches sending on in the settings. SEND_SMS sends the
      replies and messages the platform asks for; READ_PHONE_STATE (above) maps a SIM slot to the subscription that sends.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- The send channel is a foreground service, which only exists while sending is switched on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- CAMERA: only to scan the pairing QR code, asked when the scan button is pressed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Lets the settings page show the system "do not optimise battery for this app" dialog directly. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the user approve an APK downloaded from the signed GitHub Release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      READ_SMS (M4): only for the opt-in "sync sent messages" and history backfill, requested at the moment the user
      switches that on. Nothing reads the SMS database while it is off.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- The receiver phone may be a tablet with a SIM or a phone without telephony hardware in tests. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      usesCleartextTraffic only lifts the platform block on http://. The app itself refuses http:// unless the address is
      localhost or a private LAN address (ServerUrl), so public servers are always reached over TLS.
    -->
    <application
        android:name=".NodeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NyaSmsForwardNode"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Only the system may deliver SMS_RECEIVED: BROADCAST_SMS is a signature-level permission that regular apps
          cannot hold, so another app cannot inject fake messages into the queue.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          Results of the SMS this phone sent for the server (sent per part, delivery reports). Not exported: only the
          PendingIntents handed to the system reach it, so no other app can forge a receipt.
        -->
        <receiver android:name=".send.SendStatusReceiver" android:exported="false" />

        <!-- The send channel: a persistent WebSocket to the server, running only while sending is switched on. -->
        <service
            android:name=".service.NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a WebSocket to the user's own server open so it can ask this phone to send SMS replies" />
        </service>

        <!-- Brings the send channel back after a reboot or an app update. -->
        <receiver android:name=".service.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

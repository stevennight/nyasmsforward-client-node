<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Report received SMS to the server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The whole point of this app: receive SMS. Requested at runtime from the status screen. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Optional: read the SIM operator names for the pairing request. Slot numbers work without it. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Optional: lets the app identify a line by its own phone number after cards move between slots. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Optional (Android 13+): tell the user when the token was revoked and the phone must be paired again. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Sending (docs/协议.md §6.2, §7): only requested when the user switches sending on in the settings. SEND_SMS sends the
      replies and messages the platform asks for; READ_PHONE_STATE (above) maps a SIM slot to the subscription that sends.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- The send channel is a foreground service, which only exists while sending is switched on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- CAMERA: only to scan the pairing QR code, asked when the scan button is pressed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Lets the settings page show the system "do not optimise battery for this app" dialog directly. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the user approve an APK downloaded from the signed GitHub Release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      READ_SMS (M4): only for the opt-in "sync sent messages" and history backfill, requested at the moment the user
      switches that on. Nothing reads the SMS database while it is off.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Needed for platform-side deletion when this app is allowed to write the SMS provider. -->
    <uses-permission android:name="android.permission.WRITE_SMS" />

    <!--
      The "短信应用" feature (off by default). MMS arrives by WAP push and a default SMS app must accept it; Android grants
      these to the default SMS app by itself. READ_CONTACTS is optional (names instead of numbers in the inbox) and asked
      for from the inbox only.
    -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- The receiver phone may be a tablet with a SIM or a phone without telephony hardware in tests. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- The old full edition and this app find each other to move data across (migrate/); nothing else is queried. -->
    <queries>
        <package android:name="app.nya.smsforward.node" />
        <package android:name="app.nya.smsforward.node.full" />
    </queries>

    <!--
      usesCleartextTraffic only lifts the platform block on http://. The app itself refuses http:// unless the address is
      localhost or a private LAN address (ServerUrl), so public servers are always reached over TLS.
    -->
    <application
        android:name=".NodeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NyaSmsForwardNode"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Only the system may deliver SMS_RECEIVED: BROADCAST_SMS is a signature-level permission that regular apps
          cannot hold, so another app cannot inject fake messages into the queue.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          Results of the SMS this phone sent for the server (sent per part, delivery reports). Not exported: only the
          PendingIntents handed to the system reach it, so no other app can forge a receipt.
        -->
        <receiver android:name=".send.SendStatusReceiver" android:exported="false" />

        <!-- The send channel: a persistent WebSocket to the server, running only while sending is switched on. -->
        <service
            android:name=".service.NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a WebSocket to the user's own server open so it can ask this phone to send SMS replies" />
        </service>

        <!-- Brings the send channel back after a reboot or an app update. -->
        <receiver android:name=".service.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          The "短信应用" feature: what Android requires of a default SMS app (SMS_DELIVER / WAP_PUSH_DELIVER receivers, the
          "respond via message" service and a SENDTO activity). Only the default SMS app may write to the SMS database,
          which is what deleting a message from the phone needs. These four ship disabled (the placeholder is "true" only
          in the legacyFull flavor), so the app does not even appear in the system's list of SMS apps until the user
          switches the feature on; inbox/SmsAppFeature.kt enables and disables them.
        -->

        <!-- Other apps' "send SMS to …" (dialer, contacts, browser links) opens the conversation here. An alias, because a
             single intent filter of MainActivity could not be switched off on its own. -->
        <activity-alias
            android:name=".SmsEntry"
            android:targetActivity=".MainActivity"
            android:enabled="${smsAppComponentsEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity-alias>

        <!-- SMS_DELIVER: only the system can send it (BROADCAST_SMS), and only to the default SMS app. -->
        <receiver
            android:name=".inbox.SmsDeliverReceiver"
            android:enabled="${smsAppComponentsEnabled}"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".inbox.MmsDeliverReceiver"
            android:enabled="${smsAppComponentsEnabled}"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".inbox.RespondViaMessageService"
            android:enabled="${smsAppComponentsEnabled}"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Radio results of messages typed in the app, and the notification buttons. Not exported, always on. -->
        <receiver android:name=".inbox.LocalSendReceiver" android:exported="false" />
        <receiver android:name=".inbox.InboxActionReceiver" android:exported="false" />
        <!-- The 「平台」 notification buttons (复制验证码 / 标为已读). Not exported. -->
        <receiver android:name=".view.PlatformActionReceiver" android:exported="false" />
    </application>

</manifest>
